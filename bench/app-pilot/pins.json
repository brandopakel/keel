  "suites": [
    {
      "name": "gitea-cache-queue-session",
      "checkout": "gitea-main",
      "packages": ["./modules/cache", "./modules/queue", "./modules/session"],
      "run": "^(TestStringCacheAdapters|TestBaseRedis|TestSession)$",
      "gates": true
    },
    {
      "name": "go-redis-cache",
      "checkout": "go-redis-cache",
      "packages": ["./..."],
      "gates": true
    },
    {
      "name": "gin-contrib-sessions",
      "checkout": "gin-contrib-sessions",
      "packages": ["./redis"],
      "gates": true
    },
    {
      "name": "gitea-known-unsupported",
      "checkout": "gitea-main",
      "packages": ["./modules/globallock", "./services/pubsub"],
      "run": "^(TestLocker|TestRedisBroker)$",
      "gates": false,
      "reason": "Gitea's Redis global lock runs redsync Lua scripts and its Redis websocket broker uses Pub/Sub. Keel has neither, so these tests record the exact failures without failing the job."
    }
  ]
}
